# ---------------------------------------------------------------------------
# CampusHub client environment variables
# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).
#
# Only PUBLIC values belong here. Vite inlines every VITE_* variable into the
# client bundle, so never place a service-role key or an AI provider key here.
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The Supabase anon / publishable key. Safe for the browser: it is only usable
# together with the Row Level Security policies defined in supabase/migrations.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-SIDE SECRETS -- DO NOT PUT THESE IN THIS FILE OR IN THE REPOSITORY.
#
# The AI features call the `ai` Supabase Edge Function, which reads its
# credentials from Edge Function secrets. Set them with the Supabase CLI:
#
#   supabase secrets set AI_PROVIDER=openai
#   supabase secrets set AI_API_KEY=sk-...
#   supabase secrets set AI_MODEL=gpt-4o-mini
#   supabase secrets set AI_BASE_URL=https://api.openai.com/v1
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by the platform.
# ---------------------------------------------------------------------------
